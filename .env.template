# Configuration for docker compose (compose.yaml reads .env; it has no defaults
# of its own, so every variable below must be set: a missing one is left blank).
#
# `make` copies this file to .env the first time it runs, if .env doesn't
# exist. Edit .env (git-ignored), not this file. To use plain `docker compose`
# without make: cp .env.template .env
#
# These are local-development values, not secrets: every published port binds
# to 127.0.0.1 only.

# PostgreSQL
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=controlplane
POSTGRES_DB=controlplane
# Host port for desktop clients (DBeaver, psql); not 5432, to avoid clashing
# with a Postgres already on the host.
POSTGRES_HOST_PORT=6432

# RabbitMQ
RABBITMQ_USER=controlplane
RABBITMQ_PASSWORD=controlplane
# Host port for the management UI and HTTP API (scripts/publish-update.sh uses it).
RABBITMQ_MGMT_HOST_PORT=15672

# HTTP API host port
API_HOST_PORT=8080

# Worker flags, e.g. --fail-rate=1. `make worker ARGS="..."` overrides this for
# that run (a shell variable takes precedence over .env).
WORKER_ARGS=
