        {
          "name": "404 tenant_not_found (malformed id)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/tenants/not-a-uuid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "tenants",
                "not-a-uuid"
              ]
            },
            "description": "A malformed path id gets the same 404 as an unknown one."
          },
          "event": [
            {
              "listen": "test",
              "script": {
